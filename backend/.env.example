# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://velozity_user:velozity_pass@localhost:5432/velozity_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_hex_string_for_access_token
JWT_REFRESH_SECRET=change_this_to_a_different_random_64_char_hex_string_for_refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Cookie ───────────────────────────────────────────────────────────────────
# COOKIE_DOMAIN=yourdomain.com   # Only needed for production cross-subdomain cookies
